node_modules/
out/

# site/previews/ is COMMITTED. The gallery is the product and the previews are
# its visible surface, not a build artifact — and Pages publishes from the repo,
# so leaving them out would mean re-rendering all 24 on every deploy.
# `kw previews check` fails in CI if a committed preview no longer matches its spec.
site/gallery.json

# Fonts are fetched by `npm run setup`, not committed (SIL OFL 1.1).
engine/assets/fonts/
engine/composition/comp.js

# Your analytics exports are yours. Only mapping.csv and data.yml are shared.
measure/inbox/*
!measure/inbox/.gitkeep
!measure/inbox/retention/.gitkeep
measure/normalized/
measure/report.json
measure/report.md

.DS_Store
Thumbs.db
*.log

# Raw analytics exports. Yours, not the library's.
data/seed/raw/

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["engine/src/**/*.ts", "engine/composition/**/*.ts", "measure/**/*.ts"],
  "exclude": ["node_modules", "engine/composition/comp.js"]
}
